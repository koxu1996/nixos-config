diff --git a/src/render/pass/MirrorTogglePassElement.cpp b/src/render/pass/MirrorTogglePassElement.cpp
new file mode 100644
index 0000000..2d4ddcd
--- /dev/null
+++ b/src/render/pass/MirrorTogglePassElement.cpp
@@ -0,0 +1,43 @@
+#include "MirrorTogglePassElement.hpp"
+#include "../Renderer.hpp"
+#include "../OpenGL.hpp"
+
+CMirrorTogglePassElement::CMirrorTogglePassElement(bool pause) : m_pause(pause) {
+    ;
+}
+
+std::vector<UP<IPassElement>> CMirrorTogglePassElement::draw() {
+    const auto& FB = g_pHyprRenderer->m_renderData.mainFB;
+    if (!FB || !FB->getMirrorTexture())
+        return {};
+
+    if (m_pause) {
+        GLenum drawBuffers[] = {GL_COLOR_ATTACHMENT0};
+        glDrawBuffers(1, drawBuffers);
+    } else {
+        GLenum drawBuffers[] = {GL_COLOR_ATTACHMENT0, GL_COLOR_ATTACHMENT1};
+        glDrawBuffers(2, drawBuffers);
+    }
+
+    return {};
+}
+
+bool CMirrorTogglePassElement::needsLiveBlur() {
+    return false;
+}
+
+bool CMirrorTogglePassElement::needsPrecomputeBlur() {
+    return false;
+}
+
+std::optional<CBox> CMirrorTogglePassElement::boundingBox() {
+    return std::nullopt;
+}
+
+CRegion CMirrorTogglePassElement::opaqueRegion() {
+    return {};
+}
+
+bool CMirrorTogglePassElement::undiscardable() {
+    return true;
+}
diff --git a/src/render/pass/MirrorTogglePassElement.hpp b/src/render/pass/MirrorTogglePassElement.hpp
new file mode 100644
index 0000000..945eef8
--- /dev/null
+++ b/src/render/pass/MirrorTogglePassElement.hpp
@@ -0,0 +1,26 @@
+#pragma once
+#include "PassElement.hpp"
+
+class CMirrorTogglePassElement : public IPassElement {
+  public:
+    CMirrorTogglePassElement(bool pause);
+    virtual ~CMirrorTogglePassElement() = default;
+
+    virtual std::vector<UP<IPassElement>> draw();
+    virtual bool                          needsLiveBlur();
+    virtual bool                          needsPrecomputeBlur();
+    virtual std::optional<CBox>           boundingBox();
+    virtual CRegion                       opaqueRegion();
+    virtual bool                          undiscardable();
+
+    virtual const char*                   passName() {
+        return "CMirrorTogglePassElement";
+    }
+
+    virtual ePassElementType type() {
+        return EK_CUSTOM;
+    };
+
+  private:
+    bool m_pause = false;
+};
