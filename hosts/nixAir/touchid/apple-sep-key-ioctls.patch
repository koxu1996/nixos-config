+/*
+ * Per-use enclave keys. KEY_CREATE: the enclave makes a P-256 key pair and returns
+ * the public point and the wrapped private key ('blob', only usable by this
+ * enclave). KEY_SIGN: ECDSA-P256 over 'digest' (pre-computed) with that blob.
+ */
+#define SEP_BIO_KEY_BLOB_MAX 1024
+
+struct sep_bio_key_create {
+  __u32 blob_len;                              /* out */
+  __u8  public[SEP_BIO_ATTEST_PUB_LEN];        /* out: P-256 point, 04||X||Y */
+  __u8  reserved[3];
+  __u8  blob[SEP_BIO_KEY_BLOB_MAX];            /* out: wrapped key */
+};
+
+struct sep_bio_key_sign {
+  __u32 blob_len;                              /* in */
+  __u32 sig_len;                               /* out: DER signature length */
+  __u8  digest[SEP_BIO_CHALLENGE_LEN];         /* in */
+  __u8  signature[SEP_BIO_ATTEST_SIG_MAX];     /* out: DER SEQUENCE{r,s} */
+  __u8  blob[SEP_BIO_KEY_BLOB_MAX];            /* in: from KEY_CREATE */
+};
+
 #define SEP_BIO_IOC_MAGIC 0xB1
 
 #define SEP_BIO_GET_INFO     _IOR (SEP_BIO_IOC_MAGIC, 0x01, struct sep_bio_info)
