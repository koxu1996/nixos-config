+/// Upper bound for a wrapped per-key ref-key blob (the machine key's is 344 bytes).
+pub(crate) const KEY_BLOB_MAX: usize = 1024;
+
+/// `SEP_BIO_KEY_CREATE`: the enclave creates a new P-256 key pair. Userspace gets
+/// the public point and the wrapped private-key blob; the private key itself never
+/// leaves the enclave, and the blob is only usable by this enclave and keybag.
+#[repr(C)]
+pub(crate) struct KeyCreate {
+    /// out: length of `blob`.
+    pub(crate) blob_len: u32,
+    /// out: public point, `04‖X‖Y`.
+    pub(crate) public: [u8; ATTEST_PUB_LEN],
+    pub(crate) reserved: [u8; 3],
+    /// out: wrapped key blob, zero-padded to `KEY_BLOB_MAX`.
+    pub(crate) blob: [u8; KEY_BLOB_MAX],
+}
+
+/// `SEP_BIO_KEY_SIGN`: the enclave signs `digest` (ECDSA-P256 over the digest as
+/// given) with the key wrapped in `blob`.
+#[repr(C)]
+pub(crate) struct KeySign {
+    /// in: length of `blob`.
+    pub(crate) blob_len: u32,
+    /// out: DER signature length.
+    pub(crate) sig_len: u32,
+    /// in: pre-computed digest to sign.
+    pub(crate) digest: [u8; ATTEST_CHALLENGE_LEN],
+    /// out: DER signature, zero-padded to `ATTEST_SIG_MAX`.
+    pub(crate) signature: [u8; ATTEST_SIG_MAX],
+    /// in: wrapped key blob from `SEP_BIO_KEY_CREATE`.
+    pub(crate) blob: [u8; KEY_BLOB_MAX],
+}
