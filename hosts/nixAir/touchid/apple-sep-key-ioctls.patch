+    /// A new enclave key pair for userspace (op `oc`, the same class and key type as
+    /// the machine ref-key). Returns the wrapped blob and the public point. Nothing
+    /// is persisted here: the caller keeps the blob.
+    pub(crate) fn refkey_create_user(&self) -> Result<(KVec<u8>, KVec<u8>)> {
+        // The machine key's setup has already designated and unlocked the identity
+        // bag on this boot; reuse it so a user key never takes a first-time path.
+        self.ensure_machine_refkey()?;
+        let keybag::State::Present(stored) = keybag::read(keybag::Slot::Identity)? else {
+            return Err(ENODEV);
+        };
+        let (handle, _uuid) = self.sks_recover(&stored).ok_or(EIO)?;
+        let blob = self.sks_create_refkey(handle, stored.secret());
+        let _ = self.sks_send(self.sks_req_unload_keybag(handle));
+        let blob = blob.ok_or(EIO)?;
+        let pubv = Self::refkey_pub(&blob).ok_or(EIO)?;
+        let mut pub_raw: KVec<u8> = KVec::new();
+        pub_raw.extend_from_slice(pubv, GFP_KERNEL)?;
+        Ok((blob, pub_raw))
+    }
+
+    /// Op `osgn` with a caller-supplied wrapped blob: ECDSA-P256 over `digest`.
+    /// The blob is only shape-checked here; the enclave rejects anything it did not wrap.
+    pub(crate) fn refkey_sign_user(&self, blob: &[u8], digest: &[u8]) -> Result<KVec<u8>> {
+        Self::refkey_pub(blob).ok_or(EINVAL)?;
+        self.ensure_machine_refkey()?;
+        let keybag::State::Present(stored) = keybag::read(keybag::Slot::Identity)? else {
+            return Err(ENODEV);
+        };
+        let (handle, _uuid) = self.sks_recover(&stored).ok_or(EIO)?;
+        if let Some(healthy) = self.sks_health_check(c"ref-key user sign") {
+            let _ = self.sks_send(self.sks_req_change_lock_state(
+                handle,
+                LockState::Unlocked,
+                stored.secret(),
+                healthy,
+            ));
+        }
+        let sig = self.sks_refkey_sign(handle, blob, digest);
+        let _ = self.sks_send(self.sks_req_unload_keybag(handle));
+        sig.ok_or(EIO)
+    }
