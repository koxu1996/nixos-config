# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{ config, lib, pkgs, modulesPath, ... }:

{
  imports =
    [ (modulesPath + "/installer/scan/not-detected.nix")
    ];

  boot.initrd.availableKernelModules = [ "xhci_pci" "ahci" "usbhid" "usb_storage" "uas" "sd_mod" ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-intel" "snd_hda_intel" ];
  boot.extraModulePackages = [ ];

  boot.kernelParams = [
    # Disable fucking i915 GPU... it cause various CPU hangs.
    # NOTE: We cannot just blacklist the whole i915 module with modprobe, as we want audio to work (snd_hda_intel).
    "i915.modeset=0"
  ];

  boot.extraModprobeConfig = ''
    # Disable fucking i915... it cause various CPU hangs.
    #blacklist i915
  '';

  fileSystems."/" =
    { device = "none";
      fsType = "tmpfs";
      options = [ "defaults" "size=4G" "mode=755" ];
    };

  fileSystems."/boot" =
    { device = "/dev/disk/by-uuid/7112-3230";
      fsType = "vfat";
      options = [ "fmask=0022" "dmask=0022" ];
    };

  fileSystems."/nix" =
    { device = "/dev/disk/by-uuid/d23c510e-f789-427b-8b4d-c09500ca897a";
      neededForBoot = true;
      fsType = "ext4";
    };

  fileSystems."/persistence" =
    { device = "/nix/persist2";
      neededForBoot = true;
      fsType = "none";
      options = [ "bind" ];
    };

  # Manage NixOS config directly from the user directory.
  fileSystems."/etc/nixos" =
    { device = "/nix/persist2/home/andrew/nixos";
      fsType = "none";
      options = [ "bind" ];
    };

  swapDevices = [ ];

  # Enables DHCP on each ethernet and wireless interface. In case of scripted networking
  # (the default) this is the recommended approach. When using systemd-networkd it's
  # still possible to use this option, but it's recommended to use it in conjunction
  # with explicit per-interface declarations with `networking.interfaces.<interface>.useDHCP`.
  networking.useDHCP = lib.mkDefault true;
  # networking.interfaces.eno1.useDHCP = lib.mkDefault true;

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
