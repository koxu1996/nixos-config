# The Quickshell bar's palette (quickshell/Theme.qml), for everything else that wants to
# match it: Alacritty, tmux, the zsh prompt (terminal.nix).
{
  base = "#12151b"; raised = "#161a21"; raisedHigh = "#1b2028"; inset = "#0c0e12";
  border = "#2a2f38"; borderSubtle = "#22262e"; track = "#252a32";
  textPrimary = "#eef0f3"; textSecondary = "#8a919b"; textDisabled = "#5f6670"; textFaint = "#3a404a";
  accent = "#c5f36a"; accentBg = "#262d1d"; warning = "#f5a524"; error = "#f2706a";
  # extra hues for ANSI, same muted tone
  blue = "#82aaff"; magenta = "#c4a7ff"; cyan = "#7dd3c8";
}
