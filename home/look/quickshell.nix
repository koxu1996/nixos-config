# The Quickshell bar's source: ./quickshell plus a generated Host.qml singleton that
# carries this host's my.look.* settings into QML, and, with programs.agent-usage on,
# Omarchy's vendored agents panel (its qs.Commons / qs.Ui modules must sit at the
# config root, since `import qs.X` resolves against it).
{ config, lib, pkgs, ... }:

let
  cfg = config.my.look;
  agentUsage = config.programs.agent-usage;
  bool = b: if b then "true" else "false";
  hostQml = ''
    // Generated by home/look/quickshell.nix from my.look.* - this host's bar features.
    pragma Singleton
    import QtQuick
    import Quickshell

    Singleton {
        readonly property bool wifi: ${bool cfg.wifi}
        readonly property bool battery: ${bool cfg.battery}
        readonly property bool glowBrightness: ${bool cfg.glowBrightness}
        readonly property int notchGap: ${toString cfg.notchGap}
        readonly property string cpuProfile: "${if cfg.cpuProfile == null then "" else cfg.cpuProfile}"
        readonly property bool agentUsage: ${bool agentUsage.enable}

        // The machine, for the CPU/MEM panel.
        readonly property string machineName: ${builtins.toJSON cfg.machine.name}
        readonly property string machineCores: ${builtins.toJSON cfg.machine.cores}
        readonly property string machineNotes: ${builtins.toJSON cfg.machine.notes}
        readonly property int coreCount: ${toString cfg.machine.coreCount}
        readonly property var eCores: [${lib.concatMapStringsSep ", " toString cfg.machine.eCores}]
        readonly property string tempLabel: ${builtins.toJSON cfg.machine.tempLabel}
        readonly property int tempWarm: ${toString cfg.machine.tempWarm}
        readonly property int tempThrottle: ${toString cfg.machine.tempThrottle}
        readonly property string powerLabel: ${builtins.toJSON cfg.machine.powerLabel}
    }
  '';
in
{
  options.my.look = {
    hostQml = lib.mkOption {
      type = lib.types.str;
      readOnly = true;
      description = "Generated Host.qml (exposed for tests).";
    };
    barSource = lib.mkOption {
      type = lib.types.package;
      readOnly = true;
      description = "The bar's QML directory with Host.qml added.";
    };
  };

  config.programs.quickshell = {
    enable = true;
    configs.bar = cfg.barSource;
    activeConfig = "bar";
    systemd = {
      enable = true;
      target = "hyprland-session.target";
    };
  };

  # The bar runs helpers (pkexec, busctl, tailscale, brightnessctl, iwctl, grim, ...)
  # and launches apps (through systemd-run scopes), so it needs the session's PATH;
  # a user service only gets a minimal one. pkexec is a setuid wrapper in /run/wrappers.
  config.systemd.user.services.quickshell.Service.Environment = [
    "PATH=/run/wrappers/bin:/etc/profiles/per-user/${config.home.username}/bin:/run/current-system/sw/bin"
  ];

  # Restart the bar when its QML changes. Quickshell only hot-reloads files it watches,
  # and a switch swaps ~/.config/quickshell/bar to a new store path without touching
  # the old files, so the running bar kept the previous config until a re-login.
  config.systemd.user.services.quickshell.Unit.X-Restart-Triggers = [ "${cfg.barSource}" ];

  # Tools the bar's scripts call (tools/screenshot.sh: hyprctl comes with Hyprland;
  # tools/share.sh: yazi from home/yazi.nix, LocalSend from home/default.nix).
  config.home.packages = [ pkgs.jq pkgs.grim pkgs.slurp pkgs.wl-clipboard pkgs.libnotify ];

  # Screen colour temperature through Hyprland's CTM protocol (also works on the Asahi
  # display, which has no gamma LUT). No hyprsunset profiles: the bar's Glow owns the
  # schedule. Start neutral until Glow applies its state.
  config.services.hyprsunset = {
    enable = true;
    extraArgs = [ "--identity" ];
    systemdTarget = "hyprland-session.target";
  };

  # Bar config files: editable symlinks into the repo, so edits apply live (the bar
  # watches them) and stay in git.
  config.xdg.configFile = lib.mapAttrs
    (_: file: { source = config.lib.file.mkOutOfStoreSymlink "${config.home.homeDirectory}/nixos/home/look/quickshell/${file}"; })
    {
      "quickshell/launcher/launcher.json" = "launcher.json"; # pinned apps
      "quickshell/glow/profiles.json" = "glow-profiles.json"; # night-light schedule
      "quickshell/clock/config.json" = "clock-config.json"; # time zones
    };

  config.my.look = {
    inherit hostQml;
    barSource = pkgs.runCommand "quickshell-bar" { passAsFile = [ "hostQml" ]; inherit hostQml; } (''
      cp -r ${./quickshell} $out
      chmod u+w $out
      cp $hostQmlPath $out/Host.qml
    '' + (if agentUsage.enable then ''
      cp -r ${agentUsage.package}/share/omarchy/shell/{Commons,Ui,plugins} $out/
    '' else ''
      rm $out/AgentsChip.qml
    ''));
  };
}
