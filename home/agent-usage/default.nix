# programs.agent-usage: Omarchy's "Agents" usage panel (vendored from basecamp/omarchy,
# MIT, see ./LICENSE and ./README.md) in this Quickshell bar, plus an OpenCode Zen
# balance collector.
#
#   bin/, shell/, default/  upstream copies (UPSTREAM lists which), plus local files
#                           marked "LOCAL" in their header
#   patches/                applied to that tree at build time
#
# The built tree is OMARCHY_PATH. Its bin/ is on PATH through thin wrappers that set
# OMARCHY_PATH and the scripts' runtime tools; its QML (Commons/, Ui/, plugins/agents/)
# is merged into the bar's config root by home/look/quickshell.nix.
{ config, lib, pkgs, ... }:

let
  cfg = config.programs.agent-usage;
  home = config.home.homeDirectory;

  expandHome = path:
    if path == "~" then home
    else if lib.hasPrefix "~/" path then home + lib.removePrefix "~" path
    else path;

  runtimeInputs = with pkgs; [
    python3
    jq
    bash
    coreutils
    findutils
    gnugrep
    gnused
    gawk
    util-linux # column, setsid
    procps # pkill
    libnotify
    xdg-utils
    gum # account-add asks for a name / account-remove confirms, on a terminal
  ];

  package = pkgs.stdenvNoCC.mkDerivation {
    pname = "agent-usage";
    version = "omarchy-quattro-${builtins.substring 0 8 (lib.removeSuffix "\n" (builtins.head (lib.splitString " " (builtins.readFile ./UPSTREAM))))}";

    src = lib.fileset.toSource {
      root = ./.;
      fileset = lib.fileset.unions [ ./bin ./shell ./default ./LICENSE ];
    };
    patches = lib.filesystem.listFilesRecursive ./patches;

    nativeBuildInputs = [ pkgs.makeWrapper ];
    buildInputs = [ pkgs.python3 pkgs.bash ]; # patchShebangs --host resolves against these

    installPhase = ''
      runHook preInstall
      root=$out/share/omarchy
      mkdir -p $root $out/bin
      cp -r bin default shell LICENSE $root/
      chmod +x $root/bin/*
      patchShebangs --host $root/bin
      for script in $root/bin/*; do
        makeWrapper "$script" "$out/bin/$(basename "$script")" \
          --set-default OMARCHY_PATH "$root" \
          --set-default TERMINAL ${lib.escapeShellArg cfg.terminal} \
          --prefix PATH : "$root/bin:${lib.makeBinPath runtimeInputs}"
      done
      runHook postInstall
    '';

    meta.license = lib.licenses.mit;
  };

  providerIds = [ "claude" "opencode" "codex" "grok" "fireworks" "kimi" ];
  disabledProviders = lib.filter (id: !cfg.providers.${id}.enable) (lib.attrNames cfg.providers);

  settings = {
    providers = lib.mapAttrs (_: p: { enabled = p.enable; }) cfg.providers;
    inherit (cfg) refreshIntervalSec;
    syncMode = if cfg.syncDir == null then "Off" else "On";
    syncDir = if cfg.syncDir == null then "" else expandHome cfg.syncDir;
    syncFileName = cfg.syncFileName;
    syncDeviceId = cfg.syncDeviceId;
  };

  t = cfg.theme;
  colorsToml = ''
    # Generated by programs.agent-usage.theme (home/agent-usage/default.nix).
    foreground = "${t.foreground}"
    background = "${t.background}"
    accent = "${t.accent}"
    red = "${t.urgent}"
    muted = "${t.muted}"
  '';
  shellToml = ''
    # Generated by programs.agent-usage.theme (home/agent-usage/default.nix).
    # Read by the vendored Commons/Color.qml and Commons/Style.qml.
    [popups]
    background = "${t.popupBackground}"
    border = "${t.popupBorder}"

    [tooltip]
    background = "${t.tooltipBackground}"
    border = "${t.tooltipBorder}"
    text = "${t.foreground}"

    [font]
    family = "${t.fontFamily}"
    base-size = ${toString t.fontSize}

    [spacing]
    scale = ${toString t.spacingScale}
    scale-with-font = false

    [shape]
    corner-radius = ${toString t.cornerRadius}
    gaps-out = ${toString t.gapsOut}

    [motion]
    scale = ${toString t.durationScale}

    [controls]
    hover-cursor-border-width = ${toString t.hoverBorderWidth}
    selected-color = "${t.selectedColor}"
    selected-fill-alpha = ${toString t.selectedFillAlpha}
  '' + t.extraShellToml;

  updateCommand = lib.escapeShellArgs ([ "${package}/bin/omarchy-agent-usage-update" ]
    ++ lib.concatMap (id: [ "--except" id ]) disabledProviders);

  # `claude` typed at a prompt runs as the active account (CLAUDE_CONFIG_DIR of the
  # account picked with `omarchy-agent-account-use` or the panel's Use).
  shellFunctions = lib.concatMapStrings (cli: ''
    ${cli}() { omarchy-agent-account-exec ${cli} "$@"; }
  '') cfg.wrapClis;

  colorOption = default: description: lib.mkOption { type = lib.types.str; inherit default description; };
in
{
  options.programs.agent-usage = {
    enable = lib.mkEnableOption "Omarchy's agents usage panel in the Quickshell bar";

    package = lib.mkOption {
      type = lib.types.package;
      readOnly = true;
      default = package;
      description = "The patched tree (share/omarchy = OMARCHY_PATH) with wrapped commands in bin/.";
    };

    refreshIntervalSec = lib.mkOption {
      type = lib.types.ints.between 30 3600;
      default = 900;
      description = "How often the usage records regenerate (the panel's timer and the systemd timer).";
    };

    providers = lib.mkOption {
      type = lib.types.attrsOf (lib.types.submodule {
        options.enable = lib.mkOption { type = lib.types.bool; default = true; description = "Collect and show this agent."; };
      });
      default = { };
      description = "Per-agent switches, by collector id (${lib.concatStringsSep ", " providerIds}).";
    };

    syncDir = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = null;
      example = "~/Sync/agent-usage";
      description = "Folder (inside a Syncthing share) for per-machine snapshots; null keeps sync off.";
    };
    syncFileName = lib.mkOption {
      type = lib.types.str;
      default = "";
      description = "This machine's snapshot file; empty means <hostname>.json.";
    };
    syncDeviceId = lib.mkOption {
      type = lib.types.str;
      default = "";
      description = "Device name inside the snapshot; empty means the hostname.";
    };

    syncthingFolder = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = null;
      example = "~/Sync";
      description = ''
        Root of the Syncthing folder that holds syncDir. When set, its .stignore gets
        (idempotently) the patterns for the snapshot writers' short-lived temp files: Qt's
        atomic write links `<host>.json.XXXXXX` before renaming it into place, and the Zen
        collector writes `.<host>.json.XXXXXXXX.tmp`.
      '';
    };

    opencodeFundingFile = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = if cfg.syncDir == null then null else "${expandHome cfg.syncDir}/opencode-funding.json";
      defaultText = lib.literalExpression ''"''${syncDir}/opencode-funding.json"'';
      description = ''
        Where ~/.config/omarchy/agents/opencode.json (the Zen funding list) really lives, as a
        mutable symlink. In the synced folder it is the same list on every machine. null leaves
        that path an ordinary file.
      '';
    };

    defaultAgent = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = "claude";
      description = "Default agent (~/.config/omarchy/defaults/agent) the panel launches, written when unset.";
    };

    terminal = lib.mkOption {
      type = lib.types.str;
      default = "alacritty";
      description = "$TERMINAL for the shims that open a terminal (omarchy-launch-tui), unless already set.";
    };

    wrapClis = lib.mkOption {
      type = lib.types.listOf (lib.types.enum [ "claude" "codex" "grok" ]);
      default = [ "claude" "codex" "grok" ];
      description = "CLIs given a shell function that execs through omarchy-agent-account-exec.";
    };

    theme = {
      foreground = colorOption "#eef0f3" "Text (Color.foreground).";
      background = colorOption "#12151b" "Base background (Color.background).";
      accent = colorOption "#c5f36a" "Accent (Color.accent): meters, the cursor.";
      urgent = colorOption "#f2706a" "Urgent (Color.urgent): near a limit, errors.";
      muted = colorOption "#8a919b" "Muted text (Color.muted).";
      popupBackground = colorOption "#161a21" "Panel card (Color.popups.background).";
      popupBorder = colorOption "#2a2f38" "Panel card border (Color.popups.border).";
      tooltipBackground = colorOption "#1b2028" "Tooltip background (Color.tooltip.background).";
      tooltipBorder = colorOption "#2a2f38" "Tooltip border (Color.tooltip.border).";
      selectedColor = colorOption "accent" "Fill colour (role or hex) of Style.selectedFillFor: meter tracks.";
      fontFamily = lib.mkOption { type = lib.types.str; default = "JetBrains Mono"; description = "Style.font.family; Nerd Font glyphs fall back to Symbols Nerd Font."; };
      fontSize = lib.mkOption { type = lib.types.ints.positive; default = 12; description = "Style.font base size (px); the type scale derives from it."; };
      spacingScale = lib.mkOption { type = lib.types.number; default = 1.0; description = "Style.space() multiplier."; };
      cornerRadius = lib.mkOption { type = lib.types.ints.unsigned; default = 14; description = "Style.cornerRadius (instead of Hyprland's rounding)."; };
      gapsOut = lib.mkOption { type = lib.types.ints.unsigned; default = 8; description = "Style.gapsOut: gap between the bar and the panel, and to screen edges."; };
      hoverBorderWidth = lib.mkOption { type = lib.types.ints.unsigned; default = 1; description = "Style.hoverBorderWidth."; };
      selectedFillAlpha = lib.mkOption { type = lib.types.number; default = 0.18; description = "Opacity of Style.selectedFillFor."; };
      durationScale = lib.mkOption { type = lib.types.number; default = 1.0; description = "Multiplier on every Style.duration(); 0 turns animation off."; };
      extraShellToml = lib.mkOption { type = lib.types.lines; default = ""; description = "Appended to the generated shell.toml (Omarchy's [section] key = value format)."; };
    };
  };

  config = lib.mkIf cfg.enable {
    # Claude and OpenCode Zen are on; the other collectors stay off until wanted.
    programs.agent-usage.providers = lib.genAttrs providerIds (id: {
      enable = lib.mkDefault (id == "claude" || id == "opencode");
    });

    home.packages = [ package pkgs.nerd-fonts.symbols-only ];
    # The panel's glyphs (󱚣, 󰐕, …) are Nerd Font icons; fontconfig must see the font.
    fonts.fontconfig.enable = true;

    home.sessionVariables.OMARCHY_PATH = "${package}/share/omarchy";

    xdg.configFile = {
      "agent-usage/settings.json".text = builtins.toJSON settings;
      "agent-usage/theme/colors.toml".text = colorsToml;
      "agent-usage/theme/shell.toml".text = shellToml;
    } // lib.optionalAttrs (cfg.opencodeFundingFile != null) {
      "omarchy/agents/opencode.json".source = config.lib.file.mkOutOfStoreSymlink cfg.opencodeFundingFile;
    };

    assertions = [{
      assertion = cfg.syncthingFolder == null
        || (cfg.syncDir != null && lib.hasPrefix (expandHome cfg.syncthingFolder + "/") (expandHome cfg.syncDir));
      message = "programs.agent-usage.syncthingFolder must contain syncDir.";
    }];

    home.activation.agentUsageStignore = lib.mkIf (cfg.syncthingFolder != null) (
      let
        folder = expandHome cfg.syncthingFolder;
        rel = lib.removePrefix (folder + "/") (expandHome cfg.syncDir);
        block = [
          "// agent-usage: temp files of snapshot writes (home/agent-usage)"
          "/${rel}/*.json.??????"
          "/${rel}/opencode-spend/.*.tmp"
        ];
      in
      lib.hm.dag.entryAfter [ "writeBoundary" ] ''
        stignore=${lib.escapeShellArg "${folder}/.stignore"}
        if [[ -d ${lib.escapeShellArg folder} ]]; then
          ${lib.concatMapStrings (line: ''
            grep -qxF ${lib.escapeShellArg line} "$stignore" 2>/dev/null || run sh -c 'printf "%s\n" "$1" >> "$2"' sh ${lib.escapeShellArg line} "$stignore"
          '') block}
        fi
      '');

    home.activation.agentUsageDefaultAgent = lib.mkIf (cfg.defaultAgent != null)
      (lib.hm.dag.entryAfter [ "writeBoundary" ] ''
        agent_file="${config.xdg.configHome}/omarchy/defaults/agent"
        if [[ ! -s $agent_file ]]; then
          run mkdir -p "$(dirname "$agent_file")"
          run sh -c 'printf "%s\n" "$1" > "$2"' sh ${lib.escapeShellArg cfg.defaultAgent} "$agent_file"
        fi
      '');

    # The bar's quickshell service runs the panel, which runs these commands.
    systemd.user.services.quickshell.Service.Environment = [
      "OMARCHY_PATH=${package}/share/omarchy"
    ];

    # Records keep regenerating with the panel closed or the bar down; the panel's own
    # timer and manual refreshes run the same command, and it serialises on its locks.
    systemd.user.services.agent-usage-update = {
      Unit.Description = "Regenerate AI agent usage records";
      Service = {
        Type = "oneshot";
        ExecStart = updateCommand;
        Environment = [
          "OMARCHY_PATH=${package}/share/omarchy"
          "PATH=/run/wrappers/bin:/etc/profiles/per-user/${config.home.username}/bin:${home}/.nix-profile/bin:/run/current-system/sw/bin"
        ];
      };
    };
    systemd.user.timers.agent-usage-update = {
      Unit.Description = "Regenerate AI agent usage records every ${toString cfg.refreshIntervalSec}s";
      Timer = {
        OnStartupSec = "1min";
        OnUnitActiveSec = "${toString cfg.refreshIntervalSec}s";
      };
      Install.WantedBy = [ "timers.target" ];
    };

    programs.zsh.initContent = shellFunctions;
    programs.bash.initExtra = shellFunctions;
  };
}
